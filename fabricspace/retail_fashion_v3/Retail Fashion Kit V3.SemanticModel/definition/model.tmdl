model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["dim_calendar","dim_hour","uc3_dim_rtl_fsh_customers","uc3_dim_rtl_fsh_discounts","uc3_dim_rtl_fsh_employees","uc3_dim_rtl_fsh_products","uc3_dim_rtl_fsh_stores","uc3_fact_rtl_fsh_sales_employee","uc3_fact_rtl_fsh_sales_hourly","uc3_fact_rtl_fsh_sales_monthly","_Measures"]

annotation PBI_ProTooling = ["DevMode"]

ref table dim_calendar
ref table dim_hour
ref table uc3_dim_rtl_fsh_customers
ref table uc3_dim_rtl_fsh_discounts
ref table uc3_dim_rtl_fsh_employees
ref table uc3_dim_rtl_fsh_products
ref table uc3_dim_rtl_fsh_stores
ref table uc3_fact_rtl_fsh_sales_employee
ref table uc3_fact_rtl_fsh_sales_hourly
ref table uc3_fact_rtl_fsh_sales_monthly
ref table _Measures

ref cultureInfo en-US

