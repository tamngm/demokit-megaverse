	measure 'Sales Lift %' =
			
			VAR w_discount = [Sales w/ Discount]
			VAR wo_discount = [Sales w/o Discount]
			RETURN
			IF(
			    ISBLANK(w_discount) || ISBLANK(wo_discount),BLANK(),
			    DIVIDE(w_discount , wo_discount,0)-1)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: core_kpi
		lineageTag: d0e80a3a-1a79-4112-93a4-014f182511f1

	measure 'Price Discount Current' =
			
			VAR baseno = AVERAGE(fact_final_zara_product_adjusted[baseline_price_no])
			VAR priceno = AVERAGE(fact_final_zara_product_adjusted[price_no])
			
			RETURN
			IF(ISBLANK(baseno) || ISBLANK(priceno), BLANK(),
			DIVIDE(
			    AVERAGE(fact_final_zara_product_adjusted[baseline_price_yes]) - AVERAGE(fact_final_zara_product_adjusted[price_yes]),
			    AVERAGE(fact_final_zara_product_adjusted[baseline_price_yes]),
			    0
			))
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: core_kpi
		lineageTag: efacc195-e954-4b94-af2a-b44312be9609

	measure 'Price Discount Rec' =
			if(ISBLANK([Price Discount Current]),BLANK(),
			                        AVERAGE(fact_final_zara_product_adjusted[baseline_price_yes]) * (1 - [Discount Rec]))
		displayFolder: core_kpi
		lineageTag: 4dd0528c-709d-4328-bd03-cfcb870dac46

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Price Discount Diff' =
			IF(ISBLANK([Price Discount Current]),BLANK(),
			            [Price Discount Rec] - AVERAGE(fact_final_zara_product_adjusted[price_yes]))
		displayFolder: core_kpi
		lineageTag: f317c6a2-a268-4698-89b3-2d68052ff804

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Vol Lift %' = ```
			
			VAR w_Discount = [Vol w/ Discount]
			VAR wo_Discount = [Vol w/o Discount]
			RETURN
			IF(
			    ISBLANK(w_Discount) || ISBLANK(wo_Discount),BLANK(),
			    DIVIDE(w_Discount,wo_Discount,0)-1)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: core_kpi
		lineageTag: 4eab4dd6-78ae-465e-b6ca-083b2d641204

	measure 'Discount Rec' = ```
			
			VAR RevLift = [Sales Lift %]
			VAR VolLift = [Vol Lift %]
			VAR CurrentDiscount = [Price Discount Current]
			VAR TargetLift = DIVIDE('zt_target_sales_lift %'[Target Sales Lift % Value], 100, 0)
			VAR AdjustmentStrength = 'zt_discount_sensitivity'[Discount Sensitivity Value]
			
			VAR CombinedLift = DIVIDE(VolLift + RevLift, 2)
			VAR LiftGap = TargetLift - CombinedLift
			
			VAR RecommendedDiscount = MAX(0, CurrentDiscount - (LiftGap * AdjustmentStrength))
			VAR GentleDiscount = MAX(0, CurrentDiscount - (ABS(RevLift) * 0.5 * AdjustmentStrength)) -- vol > 0, cus still buying
			
			--- Both metrics meeting target --  Everything fine → no change
			--- Rev ok, Vol slightly negative, Combined still ok -- Rev is covering the vol loss → monitor but no change
			--- Rev failing, Vol positive -- Customers buying more but revenue suffering → cut carefully
			--- Both negative but Combined still acceptable -- Within acceptable range → monitor but no change
			--- Combined below target -- Both failing badly → aggressive cut scaled by strength
			--- Fallback
			RETURN
			    SWITCH(
			        TRUE(),
			        RevLift >= TargetLift && VolLift >= TargetLift,CurrentDiscount,
			        RevLift >= TargetLift && VolLift < 0 && CombinedLift >= TargetLift,CurrentDiscount,
			        RevLift < TargetLift && VolLift >= 0,GentleDiscount,
			        RevLift < TargetLift && VolLift < 0 && CombinedLift >= TargetLift,CurrentDiscount,    
			        CombinedLift < TargetLift,RecommendedDiscount,
			        CurrentDiscount
			    )
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: core_kpi
		lineageTag: e4ef2983-9627-4949-8f76-1ef92abe35eb

	measure 'Discount Rec Act' =
			
			
			VAR RevLift = [Sales Lift %]
			VAR VolLift = [Vol Lift %]
			VAR combinelift = DIVIDE(RevLift + VolLift, 2)
			VAR targetlift = DIVIDE('zt_target_sales_lift %'[Target Sales Lift % Value],100,0)
			
			VAR TargetLabel = FORMAT(targetlift,"0%")
			VAR CombinedLiftLabel = FORMAT(combinelift,"0.00%")
			VAR Suffix = " (" & CombinedLiftLabel & " vs " & TargetLabel & ")"
			-- Both meeting target → keep
			-- Rev ok, Vol negative but combined still above target → monitor
			-- Rev below target, Vol positive → gentle cut
			-- Rev & Vol both negative but Combined still above target → monitor
			-- Combined below target → aggressive cut
			return
			IF(ISBLANK([Price Discount Current]),BLANK(),
			    SWITCH(TRUE(),
			        RevLift >= targetlift &&  VolLift >= targetlift , "🟢 Keep", --& Suffix
			        RevLift >= targetlift && VolLift < 0 && combinelift >= targetlift , "🟡 Monitor",
			        RevLift < targetlift && VolLift > 0 , "🟠 Gentle Cut" ,
			        RevLift < 0 && VolLift < 0 &&  combinelift >= targetlift , "🟡 Monitor",
			        combinelift < targetlift, "🔴 Aggressive Cut" ,
			        "🟢 Keep"
			))
		displayFolder: core_kpi
		lineageTag: 7db5a8ba-c96f-4c4d-8811-5fb723de623b

	measure 'Discount current status' = ```
			
			VAR RevLift = [Sales Lift %]
			VAR VolLift = [Vol Lift %]
			
			VAR CurrentSituation = 
			    SWITCH(
			        TRUE(),
			        RevLift >= 0 && VolLift >= 0,   "Both Positive",
			        RevLift < 0  && VolLift >= 0,   "Rev Negative, Vol Positive",
			        RevLift >= 0 && VolLift < 0,    "Rev Positive, Vol Negative",
			        RevLift < 0  && VolLift < 0,    "Both Negative"
			    )
			VAR Action2 = 
			    SWITCH(
			        TRUE(),
			        RevLift >= 0 && VolLift >= 0,   "Keep Discount",
			        RevLift < 0  && VolLift >= 0,   "Gentle Cut — Discount Too Deep",
			        RevLift >= 0 && VolLift < 0,    "Review Pricing — Low Demand",
			        RevLift < 0  && VolLift < 0,    "Aggressive Cut — Discount Not Working"
			    )
			
			RETURN IF(ISBLANK([Price Discount Current]),BLANK(), CurrentSituation)
			    // CurrentSituation & " → " & Action2
			```
		displayFolder: core_kpi
		lineageTag: ec9303ec-1d50-4fc2-a53a-ab23cea26a2a

	measure 'z Flag Scenario' =
			
			VAR slt = SELECTEDVALUE('zt_scenario_filter'[Scenario])
			
			RETURN
			IF(
			    ISBLANK(slt)
			        || [Discount current status] = slt,
			    1,
			    0
			)
		formatString: 0
		displayFolder: core_kpi
		lineageTag: 9abcd2d6-9e93-41e1-bcc6-6c095f852369

