table _Measures
	lineageTag: 59d3e0c9-5b92-4489-8d2f-fde093cf46f7

	measure 'Gross Sales EUR' = CALCULATE(SUM(uc3_fact_rtl_fsh_sales_monthly[gross_amount_eur]), uc3_fact_rtl_fsh_sales_monthly[transaction_type] <> "Return")
		formatString: €#,0
		displayFolder: Sales
		lineageTag: ac014776-1741-4972-ade8-88d3b09effd9

	measure 'Discounts EUR' = CALCULATE(SUM(uc3_fact_rtl_fsh_sales_monthly[discount_amount_eur]), uc3_fact_rtl_fsh_sales_monthly[transaction_type] <> "Return")
		formatString: €#,0
		displayFolder: Sales
		lineageTag: fb8cfafc-54e0-4f02-aa92-f66dec690b6e

	measure 'Sales EUR' = CALCULATE(SUM(uc3_fact_rtl_fsh_sales_monthly[line_total_eur]), uc3_fact_rtl_fsh_sales_monthly[transaction_type] <> "Return")
		formatString: €#,0
		displayFolder: Sales
		lineageTag: 08152ada-33c1-4aec-944f-00c0554c845a

	measure 'Returns EUR' = CALCULATE(SUMX(uc3_fact_rtl_fsh_sales_monthly, ABS(uc3_fact_rtl_fsh_sales_monthly[line_total_eur])), uc3_fact_rtl_fsh_sales_monthly[transaction_type] = "Return")
		formatString: €#,0
		displayFolder: Sales
		lineageTag: 4a3747ae-ae61-4af6-b29c-0cef425ad566

	measure 'Net Revenue EUR' = [Sales EUR] - [Returns EUR]
		formatString: €#,0
		displayFolder: Sales
		lineageTag: 45f0b2f2-eccf-47f3-975f-4acce3a58662

	measure 'Units Sold' = CALCULATE(SUM(uc3_fact_rtl_fsh_sales_monthly[quantity]), uc3_fact_rtl_fsh_sales_monthly[transaction_type] <> "Return")
		formatString: #,0
		displayFolder: Sales
		lineageTag: d3ababf6-986b-45b1-a570-b1af06a65492

	measure 'Units Returned' = CALCULATE(SUMX(uc3_fact_rtl_fsh_sales_monthly, ABS(uc3_fact_rtl_fsh_sales_monthly[quantity])), uc3_fact_rtl_fsh_sales_monthly[transaction_type] = "Return")
		formatString: #,0
		displayFolder: Sales
		lineageTag: 558d9492-dbd9-465b-8c85-0037b5b26a30

	measure 'COGS EUR' =
			CALCULATE(SUMX(uc3_fact_rtl_fsh_sales_monthly, uc3_fact_rtl_fsh_sales_monthly[quantity] * RELATED(uc3_dim_rtl_fsh_products[production_cost_eur])), uc3_fact_rtl_fsh_sales_monthly[transaction_type] <> "Return")
			- CALCULATE(SUMX(uc3_fact_rtl_fsh_sales_monthly, ABS(uc3_fact_rtl_fsh_sales_monthly[quantity]) * RELATED(uc3_dim_rtl_fsh_products[production_cost_eur])), uc3_fact_rtl_fsh_sales_monthly[transaction_type] = "Return")
		formatString: €#,0
		displayFolder: Sales
		lineageTag: 254a3051-ac8f-411b-b295-45037135a38a

	measure 'Gross Margin EUR' = [Net Revenue EUR] - [COGS EUR]
		formatString: €#,0
		displayFolder: Sales
		lineageTag: 7cb3236c-ea8a-4fac-ad6b-c1e6b6f6df4b

	measure 'Gross Margin %' = DIVIDE([Gross Margin EUR], [Net Revenue EUR])
