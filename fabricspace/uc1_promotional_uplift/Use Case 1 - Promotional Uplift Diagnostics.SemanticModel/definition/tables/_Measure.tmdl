	measure 'Sales Lift Color' = ```
			
			VAR CurrVal = [Sales Lift %]
			VAR slt = SELECTEDVALUE('zt_view_by_product_attribute'[View by Order])
			VAR  AvgVal = SWITCH(TRUE(), 
			                slt = 0 , CALCULATE(AVERAGEX(ALLSELECTED(uc1_dim_term[terms]),[Sales Lift %])),
			                slt = 1,CALCULATE(AVERAGEX(ALLSELECTED(uc1_dim_section[section]),[Sales Lift %])),
			                slt = 2,CALCULATE(AVERAGEX(ALLSELECTED(uc1_dim_season[season]),[Sales Lift %])),
			                slt = 3,CALCULATE(AVERAGEX(ALLSELECTED(uc1_dim_material[material]),[Sales Lift %])),
			                slt = 4,CALCULATE(AVERAGEX(ALLSELECTED('zt_discount_bucket'[discount_bucket]),[Sales Lift %])))
			RETURN
			IF(
			    ISBLANK(CurrVal),
			    BLANK(),
			    IF(CurrVal >= AvgVal, "#89C9A0", "#EFB5B9")
			)
			```
		displayFolder: core_kpi
		lineageTag: 69671149-2d49-43ae-a684-760798d1d19c

