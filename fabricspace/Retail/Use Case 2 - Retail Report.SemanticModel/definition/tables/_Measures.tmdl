	measure 'Revenue YoY Top 5 Store' =
			
			IF ( RANKX ( ALLSELECTED ( rtl_store[store_location] ), [Revenue YoY %],, DESC ) <= 5, [Revenue YoY %] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Store
		lineageTag: 817f909e-9de2-44d0-8a4e-3072fedf7f4a

	measure 'Traffic PY' = CALCULATE ( [Traffic], SAMEPERIODLASTYEAR ( dim_date[Date] ) )
		formatString: #,0
		displayFolder: Time
		lineageTag: dd447f01-6bea-4658-9d3d-efdd3aac5ff5

	measure 'Traffic YoY %' = DIVIDE ( [Traffic] - [Traffic PY], [Traffic PY] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Time
		lineageTag: 733edf9c-5c0a-48a7-b6bf-8678adfeb53a

	measure 'Traffic YoY Color' = IF ( [Traffic YoY %] < 0, "#DD3C57", "#1F49BF" )
		displayFolder: Labels
		lineageTag: a602db55-0573-4469-86bc-4b03cc107e0f

	measure 'Traffic YoY Label' = VAR _d = [Traffic YoY %] RETURN IF ( ISBLANK ( _d ), "No prior-year data", IF ( _d >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _d ), "0.0%" ) & " vs PY" )
		displayFolder: Labels
		lineageTag: ec3c4b28-d539-45fd-9283-6eb5b3552e45

	column _x
		dataType: int64
		isHidden
		lineageTag: 0a1b2c3d-2222-4a00-9000-000000000002
		summarizeBy: none
		isNameInferred
		sourceColumn: [_x]

		annotation SummarizationSetBy = Automatic

	partition _Measures = calculated
		mode: import
		source = ROW ( "_x", 0 )

