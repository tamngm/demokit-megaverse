	measure 'Rec Discount %' = ```
			
			VAR Elas = [Elasticity]
			VAR SalesUplift = [sales_uplift uc1]
			RETURN
			    SWITCH(
			        TRUE(),
			        SalesUplift >= 0, [Current Discount %],          
			        Elas >= -1, 0,                                   
			        -1 / (2 * Elas)                                  
			    )
			
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: z_test
		lineageTag: a3645afb-74b6-4c50-8d0c-4da668af2e06

	measure 'Current Discount %' = 1 - DIVIDE(sum(uc1_fact_sales_promotion[price_yes]), sum(uc1_fact_sales_promotion[price_yes]))
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: z_test
		lineageTag: c2ff7c01-0af7-42b5-b870-064a490e5138

	measure 'Rec Action' =
			
			VAR SalesUplift = [sales_uplift uc1]
			VAR Elas = [Elasticity]
			RETURN
			    SWITCH(
			        TRUE(),
			        SalesUplift >= 0, "Keep current discount",
			        Elas >= -1, "Remove discount - volume not responding",
			        [Rec Discount %] < [Current Discount %], "Reduce discount",
			        "Review manually"
			    )
		displayFolder: z_test
		lineageTag: d8ff5cca-ea78-41c0-a7f8-61a0297cf18b

