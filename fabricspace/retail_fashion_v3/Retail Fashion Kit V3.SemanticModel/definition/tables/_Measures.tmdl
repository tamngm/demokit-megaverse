	measure 'Recency 91–180d' = COUNTROWS(FILTER(uc3_dim_rtl_fsh_customers, uc3_dim_rtl_fsh_customers[frequency] > 0 && uc3_dim_rtl_fsh_customers[recency_days] > 90 && uc3_dim_rtl_fsh_customers[recency_days] <= 180)) + 0
		formatString: #,0
		displayFolder: Customer RFM
		lineageTag: d6d99f05-0bae-43ec-b3d4-9a146f57ebb8

	measure 'Recency 181–365d' = COUNTROWS(FILTER(uc3_dim_rtl_fsh_customers, uc3_dim_rtl_fsh_customers[frequency] > 0 && uc3_dim_rtl_fsh_customers[recency_days] > 180 && uc3_dim_rtl_fsh_customers[recency_days] <= 365)) + 0
		formatString: #,0
		displayFolder: Customer RFM
		lineageTag: 37ba0883-9dbd-412b-89d4-b51ad8393e91

	measure 'Recency 365d+' = COUNTROWS(FILTER(uc3_dim_rtl_fsh_customers, uc3_dim_rtl_fsh_customers[frequency] > 0 && uc3_dim_rtl_fsh_customers[recency_days] > 365)) + 0
		formatString: #,0
		displayFolder: Customer RFM
		lineageTag: f0135aa3-5c25-4498-9491-ac69e61e0a39

	measure 'Frequency 1' = COUNTROWS(FILTER(uc3_dim_rtl_fsh_customers, uc3_dim_rtl_fsh_customers[frequency] = 1)) + 0
		formatString: #,0
		displayFolder: Customer RFM
		lineageTag: 8433d4af-a6d9-49f2-9588-78c79b633674

	measure 'Frequency 2' = COUNTROWS(FILTER(uc3_dim_rtl_fsh_customers, uc3_dim_rtl_fsh_customers[frequency] = 2)) + 0
		formatString: #,0
		displayFolder: Customer RFM
		lineageTag: 05a094fd-747e-4dd2-9fbb-b914052d64f8

	measure 'Frequency 3–5' = COUNTROWS(FILTER(uc3_dim_rtl_fsh_customers, uc3_dim_rtl_fsh_customers[frequency] >= 3 && uc3_dim_rtl_fsh_customers[frequency] <= 5)) + 0
		formatString: #,0
		displayFolder: Customer RFM
		lineageTag: d7e9c769-5a07-49a4-9d69-f83e3de3a96f

	measure 'Frequency 6+' = COUNTROWS(FILTER(uc3_dim_rtl_fsh_customers, uc3_dim_rtl_fsh_customers[frequency] >= 6)) + 0
		formatString: #,0
		displayFolder: Customer RFM
		lineageTag: bc9eea7c-3edc-4943-ad91-d53cb0a48f9b

	measure 'CLV P80' = PERCENTILEX.INC(FILTER(ALL(uc3_dim_rtl_fsh_customers), uc3_dim_rtl_fsh_customers[monetary_eur] > 0), uc3_dim_rtl_fsh_customers[monetary_eur], 0.8)
		formatString: €#,0
		displayFolder: Customer RFM
		lineageTag: 17463b8b-7105-492e-a941-b12d00fe8a77

	measure 'CLV P50' = PERCENTILEX.INC(FILTER(ALL(uc3_dim_rtl_fsh_customers), uc3_dim_rtl_fsh_customers[monetary_eur] > 0), uc3_dim_rtl_fsh_customers[monetary_eur], 0.5)
		formatString: €#,0
		displayFolder: Customer RFM
		lineageTag: e1c8f92b-dda6-4087-92fc-c479749ff7a0

	measure 'Monetary Top 20%' = VAR t = [CLV P80] RETURN COUNTROWS(FILTER(uc3_dim_rtl_fsh_customers, uc3_dim_rtl_fsh_customers[monetary_eur] >= t)) + 0
		formatString: #,0
		displayFolder: Customer RFM
		lineageTag: 2edf5265-0a73-4bb1-b140-94e5b7d1f5d1

	measure 'Monetary Next 30%' = VAR t = [CLV P80] VAR b = [CLV P50] RETURN COUNTROWS(FILTER(uc3_dim_rtl_fsh_customers, uc3_dim_rtl_fsh_customers[monetary_eur] >= b && uc3_dim_rtl_fsh_customers[monetary_eur] < t)) + 0
		formatString: #,0
		displayFolder: Customer RFM
		lineageTag: 0a26fec5-5f6f-421f-a191-a1468dfab8f1

	measure 'Monetary Bottom 50%' = VAR b = [CLV P50] RETURN COUNTROWS(FILTER(uc3_dim_rtl_fsh_customers, uc3_dim_rtl_fsh_customers[monetary_eur] > 0 && uc3_dim_rtl_fsh_customers[monetary_eur] < b)) + 0
		formatString: #,0
		displayFolder: Customer RFM
		lineageTag: 93071411-88af-407c-847a-72e57ff04be9

	measure 'High-value Churn Risk' = VAR t = [CLV P80] RETURN COUNTROWS(FILTER(uc3_dim_rtl_fsh_customers, uc3_dim_rtl_fsh_customers[recency_days] > 90 && uc3_dim_rtl_fsh_customers[monetary_eur] >= t)) + 0
		formatString: #,0
		displayFolder: Customer RFM
		lineageTag: 691351b8-b35f-4291-a926-98954fa96d9f

	measure 'Churn Lifetime Value EUR' = IF(HASONEVALUE(uc3_dim_rtl_fsh_customers[customer_id]) && MAX(uc3_dim_rtl_fsh_customers[recency_days]) > 90, MAX(uc3_dim_rtl_fsh_customers[monetary_eur]))
		formatString: €#,0
		displayFolder: Churn
		lineageTag: 87f6ebf1-5c83-4ce2-924c-b75bbe0a09d3

	measure 'Churn Days Inactive' = IF(HASONEVALUE(uc3_dim_rtl_fsh_customers[customer_id]) && MAX(uc3_dim_rtl_fsh_customers[recency_days]) > 90, MAX(uc3_dim_rtl_fsh_customers[recency_days]))
		formatString: #,0
		displayFolder: Churn
		lineageTag: d0847a3c-950c-45c2-ae0d-4181810d3060

	measure 'Churn Purchases' = IF(HASONEVALUE(uc3_dim_rtl_fsh_customers[customer_id]) && MAX(uc3_dim_rtl_fsh_customers[recency_days]) > 90, MAX(uc3_dim_rtl_fsh_customers[frequency]))
		formatString: #,0
		displayFolder: Churn
		lineageTag: 1e9c13fd-b91a-40db-931e-8fa1709a1f39

	measure 'Churn Last Purchase' = IF(HASONEVALUE(uc3_dim_rtl_fsh_customers[customer_id]) && MAX(uc3_dim_rtl_fsh_customers[recency_days]) > 90, MAX(uc3_dim_rtl_fsh_customers[last_purchase_date]))
		formatString: dd mmm yyyy
		displayFolder: Churn
		lineageTag: 1e873a80-2458-49f1-9854-fe267ed97be3

	measure 'Product Code Hex' = SELECTEDVALUE(uc3_dim_rtl_fsh_products[color_hex])
		lineageTag: ad96d1b5-ebf2-4daa-a69a-9fef2358bf19

	column Value
		dataType: string
		isHidden
		lineageTag: 96f4d2c7-433e-488b-9407-6c0033464b31
		summarizeBy: none
		sourceColumn: Value

	partition _Measures = m
		mode: import
		source = #table(type table [Value = text], {})

