	/// Line revenue; assumes price is the unit price
	column Revenue = rtl_sales[quantity] * rtl_sales[price]
		dataType: double
		formatString: #,0.00
		lineageTag: 6d0c2b1e-4a3f-4c8e-b2a1-1f0e9d8c7b01
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Price Band' =
			SWITCH (
			    TRUE (),
			    rtl_sales[price] < 10, "1. <10",
			    rtl_sales[price] < 25, "2. 10-25",
			    rtl_sales[price] < 50, "3. 25-50",
			    rtl_sales[price] < 100, "4. 50-100",
			    "5. 100+"
			)
		dataType: string
		lineageTag: 6d0c2b1e-4a3f-4c8e-b2a1-1f0e9d8c7b02
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

