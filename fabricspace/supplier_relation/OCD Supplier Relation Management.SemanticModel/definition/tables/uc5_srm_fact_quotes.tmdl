/// Grain: one row per quote (quote_key = oid + quote_number). Exact duplicate rows removed; documents of one oid without a quote_number grouped into one quote. Amounts in the quote currency and in EUR.
table uc5_srm_fact_quotes
	lineageTag: 0be6cdd2-1e42-4360-8a2b-da46bd079716

	/// Quote key (hash of oid + quote_number); joins to the other uc5 facts
	column quote_key
		dataType: string
		lineageTag: a7cff45a-a57d-4ac9-8739-9d2addd5c311
		summarizeBy: none
		sourceColumn: quote_key

		annotation SummarizationSetBy = Automatic

	/// Opportunity id
	column oid
		dataType: string
		lineageTag: 6d62ee65-5e01-4892-bf74-71603c515a03
		summarizeBy: none
