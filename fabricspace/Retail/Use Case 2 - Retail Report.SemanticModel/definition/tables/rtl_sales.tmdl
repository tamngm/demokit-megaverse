		annotation UnderlyingDateTimeDataType = Date

	partition rtl_sales = m
		mode: import
		source =
				let
				    Source = AmazonAthena.Databases("athena-bi-demo", null, []),
				    AwsDataCatalog_Database = Source{[Name="AwsDataCatalog",Kind="Database"]}[Data],
				    offybi_Schema = AwsDataCatalog_Database{[Name="offybi_mart",Kind="Schema"]}[Data],
				    rtl_sales_Table = offybi_Schema{[Name="fact_rtl_sales",Kind="Table"]}[Data]
