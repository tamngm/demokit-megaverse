{
  "name": "Officience BI",
  "dataColors": [
    "#1F49BF",
    "#FD941D",
    "#A0A0A0",
    "#DD3C57",
    "#8FA4DF",
    "#FFCE00",
    "#0F1219",
    "#FFBFC7",
    "#C7D1EF",
    "#FEC98E",
    "#D0D0D0",
    "#EE9DAB"
  ],
  "foreground": "#0F1219",
  "foregroundNeutralSecondary": "#5F6368",
  "foregroundNeutralTertiary": "#A0A0A0",
  "background": "#FFFFFF",
  "backgroundLight": "#F7F7F7",
  "backgroundNeutral": "#E4E6EA",
  "tableAccent": "#1F49BF",
  "good": "#1F49BF",
  "neutral": "#FD941D",
  "bad": "#DD3C57",
  "maximum": "#1F49BF",
  "center": "#8FA4DF",
  "minimum": "#EEF1FA",
  "null": "#D0D0D0",
  "hyperlink": "#1F49BF",
  "visitedHyperlink": "#16348A",
  "textClasses": {
    "callout": {
      "fontSize": 26,
      "fontFace": "Segoe UI Semibold",
      "color": "#0F1219"
    },
    "title": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#0F1219"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#0F1219"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#5F6368"
    },
    "largeTitle": {
      "fontSize": 16,
      "fontFace": "Segoe UI Bold",
      "color": "#0F1219"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E4E6EA" } }, "radius": 8 }],
        "dropShadow": [{ "show": false }],
        "padding": [{ "top": 10, "bottom": 10, "left": 12, "right": 12 }],
        "title": [{
          "show": true,
          "fontColor": { "solid": { "color": "#0F1219" } },
          "fontSize": 11,
          "fontFamily": "Segoe UI Semibold",
          "alignment": "left"
        }],
        "subTitle": [{
          "fontColor": { "solid": { "color": "#5F6368" } },
          "fontSize": 9,
          "fontFamily": "Segoe UI"
        }],
        "visualHeader": [{
          "foreground": { "solid": { "color": "#A0A0A0" } },
          "border": { "solid": { "color": "#E4E6EA" } },
          "background": { "solid": { "color": "#FFFFFF" } },
          "transparency": 0
        }],
        "visualTooltip": [{
          "titleFontColor": { "solid": { "color": "#FFFFFF" } },
          "valueFontColor": { "solid": { "color": "#FFFFFF" } },
          "background": { "solid": { "color": "#0F1219" } },
          "fontSize": 9
        }],
        "categoryAxis": [{
          "labelColor": { "solid": { "color": "#5F6368" } },
          "fontSize": 9,
          "titleColor": { "solid": { "color": "#5F6368" } },
          "showAxisTitle": false,
          "gridlineShow": false
        }],
        "valueAxis": [{
          "labelColor": { "solid": { "color": "#5F6368" } },
          "fontSize": 9,
          "titleColor": { "solid": { "color": "#5F6368" } },
          "showAxisTitle": false,
          "gridlineShow": true,
          "gridlineColor": { "solid": { "color": "#EDEEF1" } },
          "gridlineThickness": 1,
          "gridlineStyle": "solid"
        }],
        "legend": [{
          "show": true,
          "position": "Top",
          "labelColor": { "solid": { "color": "#5F6368" } },
          "fontSize": 9,
          "fontFamily": "Segoe UI"
        }],
        "labels": [{
          "color": { "solid": { "color": "#0F1219" } },
          "fontSize": 9,
          "fontFamily": "Segoe UI"
        }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F7F7F7" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#EDEEF1" } }, "transparency": 0 }]
      }
    },
    "outspacePane": {
      "*": {
        "backgroundColor": [{ "solid": { "color": "#FFFFFF" } }],
        "foregroundColor": [{ "solid": { "color": "#0F1219" } }],
        "borderColor": [{ "solid": { "color": "#E4E6EA" } }],
        "transparency": [{ "value": 0 }],
        "titleSize": [{ "value": 12 }],
        "headerSize": [{ "value": 10 }],
        "fontFamily": [{ "value": "Segoe UI" }]
      }
    },
    "filterCard": {
      "Available": {
        "backgroundColor": [{ "solid": { "color": "#F7F7F7" } }],
        "foregroundColor": [{ "solid": { "color": "#0F1219" } }],
        "border": [{ "value": true }],
        "borderColor": [{ "solid": { "color": "#E4E6EA" } }],
        "transparency": [{ "value": 0 }]
      },
      "Applied": {
        "backgroundColor": [{ "solid": { "color": "#EEF1FA" } }],
        "foregroundColor": [{ "solid": { "color": "#0F1219" } }],
        "border": [{ "value": true }],
        "borderColor": [{ "solid": { "color": "#1F49BF" } }],
        "transparency": [{ "value": 0 }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "color": { "solid": { "color": "#0F1219" } }, "fontSize": 26, "fontFamily": "Segoe UI Semibold" }],
        "categoryLabels": [{ "show": true, "color": { "solid": { "color": "#5F6368" } }, "fontSize": 9 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E4E6EA" } }, "radius": 8 }]
      }
    },
    "cardVisual": {
      "*": {
        "value": [{ "fontColor": { "solid": { "color": "#0F1219" } }, "fontSize": 26, "fontFamily": "Segoe UI Semibold" }],
        "label": [{ "fontColor": { "solid": { "color": "#5F6368" } }, "fontSize": 9 }],
        "accentBar": [{ "show": true, "color": { "solid": { "color": "#1F49BF" } }, "position": "Left", "width": 4 }]
      }
    },
    "multiRowCard": {
      "*": {
        "dataLabels": [{ "color": { "solid": { "color": "#0F1219" } }, "fontSize": 16 }],
        "categoryLabels": [{ "color": { "solid": { "color": "#5F6368" } }, "fontSize": 9 }],
        "card": [{ "barShow": true, "barColor": { "solid": { "color": "#1F49BF" } }, "barWeight": 3, "outlineColor": { "solid": { "color": "#E4E6EA" } } }]
      }
    },
    "kpi": {
      "*": {
        "indicator": [{ "fontSize": 24, "indicatorDisplayUnits": 0 }],
        "trendline": [{ "show": true, "transparency": 80 }],
        "goals": [{ "showGoal": true, "showDistance": true, "goalFontColor": { "solid": { "color": "#5F6368" } } }],
        "status": [{ "goodColor": { "solid": { "color": "#1F49BF" } }, "neutralColor": { "solid": { "color": "#FD941D" } }, "badColor": { "solid": { "color": "#DD3C57" } } }]
      }
    },
    "tableEx": {
      "*": {
        "grid": [{
          "gridVertical": false,
          "gridHorizontal": true,
          "gridHorizontalColor": { "solid": { "color": "#EDEEF1" } },
          "outlineColor": { "solid": { "color": "#E4E6EA" } },
          "rowPadding": 4,
          "textSize": 9
        }],
        "columnHeaders": [{
          "fontColor": { "solid": { "color": "#0F1219" } },
          "backColor": { "solid": { "color": "#F7F7F7" } },
          "bold": true,
          "outline": "BottomOnly",
          "outlineColor": { "solid": { "color": "#1F49BF" } }
        }],
        "values": [{
          "fontColorPrimary": { "solid": { "color": "#0F1219" } },
          "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
          "fontColorSecondary": { "solid": { "color": "#0F1219" } },
          "backColorSecondary": { "solid": { "color": "#FAFAFB" } }
        }],
        "total": [{
          "fontColor": { "solid": { "color": "#0F1219" } },
          "backColor": { "solid": { "color": "#EEF1FA" } },
          "bold": true
        }]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [{
          "gridVertical": false,
          "gridHorizontal": true,
          "gridHorizontalColor": { "solid": { "color": "#EDEEF1" } },
          "rowPadding": 4,
          "textSize": 9
        }],
        "columnHeaders": [{
          "fontColor": { "solid": { "color": "#0F1219" } },
          "backColor": { "solid": { "color": "#F7F7F7" } },
          "bold": true,
          "outline": "BottomOnly",
          "outlineColor": { "solid": { "color": "#1F49BF" } }
        }],
        "rowHeaders": [{
          "fontColor": { "solid": { "color": "#0F1219" } },
          "backColor": { "solid": { "color": "#FFFFFF" } }
        }],
        "values": [{
          "fontColorPrimary": { "solid": { "color": "#0F1219" } },
          "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
          "backColorSecondary": { "solid": { "color": "#FAFAFB" } }
        }],
        "subTotals": [{
          "fontColor": { "solid": { "color": "#0F1219" } },
          "backColor": { "solid": { "color": "#F7F7F7" } },
          "bold": true
        }],
        "total": [{
          "fontColor": { "solid": { "color": "#0F1219" } },
          "backColor": { "solid": { "color": "#EEF1FA" } },
          "bold": true
        }]
      }
    },
    "slicer": {
      "*": {
        "header": [{ "fontColor": { "solid": { "color": "#5F6368" } }, "textSize": 9, "fontFamily": "Segoe UI Semibold", "outline": "None" }],
        "items": [{
          "fontColor": { "solid": { "color": "#0F1219" } },
          "background": { "solid": { "color": "#FFFFFF" } },
          "textSize": 10,
          "outline": "None"
        }],
        "selection": [{ "selectAllCheckboxEnabled": true }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E4E6EA" } }, "radius": 6 }],
        "title": [{ "show": false }]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [{ "strokeWidth": 2, "showMarker": false, "lineStyle": "solid" }]
      }
    },
    "columnChart": {
      "*": {
        "layout": [{ "ratio": 0.6 }]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "layout": [{ "ratio": 0.6 }]
      }
    },
    "barChart": {
      "*": {
        "layout": [{ "ratio": 0.6 }]
      }
    },
    "clusteredBarChart": {
      "*": {
        "layout": [{ "ratio": 0.6 }]
      }
    },
    "donutChart": {
      "*": {
        "slices": [{ "innerRadiusRatio": 65 }],
        "legend": [{ "show": true, "position": "Right" }],
        "labels": [{ "show": false }]
      }
    },
    "textbox": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }]
      }
    },
    "image": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }]
      }
    },
    "shape": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }],
        "fill": [{ "fillColor": { "solid": { "color": "#1F49BF" } }, "transparency": 0 }],
        "outline": [{ "show": false }]
      }
    },
    "actionButton": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }]
      }
    }
  }
}
