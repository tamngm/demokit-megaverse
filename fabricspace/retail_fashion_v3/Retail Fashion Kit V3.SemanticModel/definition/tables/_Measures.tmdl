	measure 'Net Revenue EUR PY' = IF(MIN(dim_calendar[date]) <= [Data End Date], CALCULATE([Net Revenue EUR], SAMEPERIODLASTYEAR(dim_calendar[date])))
		formatString: €#,0
		displayFolder: Time
		lineageTag: 5bf060d3-8e22-4284-bdd7-67f517883783

	measure 'Net Revenue EUR PM' = IF(MIN(dim_calendar[date]) <= [Data End Date], CALCULATE([Net Revenue EUR], DATEADD(dim_calendar[date], -1, MONTH)))
		formatString: €#,0
		displayFolder: Time
		lineageTag: e0099ebd-81f2-4693-ab0e-9e69ea28ba20

	measure 'Net Revenue EUR YoY %' =
			VAR e = MIN(MAX(dim_calendar[date]), [Data End Date])
			VAR p = FILTER(VALUES(dim_calendar[date]), YEAR(dim_calendar[date]) = YEAR(e) && dim_calendar[date] <= e)
			VAR c = CALCULATE([Net Revenue EUR], p)
			VAR b = CALCULATE([Net Revenue EUR], SAMEPERIODLASTYEAR(p))
			RETURN DIVIDE(c - b, b)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Time
		lineageTag: b30f98c1-0eb0-496e-b19f-d9cb40f2c008

	measure 'Net Revenue EUR MoM %' =
			VAR e = MIN(MAX(dim_calendar[date]), [Data End Date])
			VAR p = FILTER(VALUES(dim_calendar[date]), dim_calendar[date] >= DATE(YEAR(e), MONTH(e), 1) && dim_calendar[date] <= e)
			VAR c = CALCULATE([Net Revenue EUR], p)
			VAR b = CALCULATE([Net Revenue EUR], DATEADD(p, -1, MONTH))
			RETURN DIVIDE(c - b, b)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Time
		lineageTag: f1d8d4aa-1c35-4eb3-87d3-6cde87543584

	measure 'Net Revenue EUR Monthly YoY %' = DIVIDE([Net Revenue EUR] - [Net Revenue EUR PY], [Net Revenue EUR PY])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Time
		lineageTag: 75a3dff7-00a0-48e7-8f04-0e0008ff9e22

	measure 'Net Revenue EUR Monthly MoM %' = DIVIDE([Net Revenue EUR] - [Net Revenue EUR PM], [Net Revenue EUR PM])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Time
		lineageTag: 40519f8d-b7ba-4f81-bff1-86176f17a378

	measure 'Net Revenue EUR Evolution Label' =
			VAR y = [Net Revenue EUR YoY %]
			VAR mo = [Net Revenue EUR MoM %]
			VAR ty = IF(ISBLANK(y), "YoY n/a", IF(y >= 0, "▲ +", "▼ -") & FORMAT(ABS(y), "0.0%") & " YoY")
			VAR tm = IF(ISBLANK(mo), "MoM n/a", IF(mo >= 0, "▲ +", "▼ -") & FORMAT(ABS(mo), "0.0%") & " MoM")
			RETURN ty & "  ·  " & tm
		displayFolder: Time
		lineageTag: 935e8199-e2a8-4f10-99f8-9428abcc5786

	measure 'Gross Margin % PY' = IF(MIN(dim_calendar[date]) <= [Data End Date], CALCULATE([Gross Margin %], SAMEPERIODLASTYEAR(dim_calendar[date])))
		formatString: 0.0%
