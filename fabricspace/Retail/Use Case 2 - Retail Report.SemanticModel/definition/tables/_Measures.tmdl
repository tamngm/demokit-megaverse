		formatString: #,0
		displayFolder: Product
		lineageTag: 4dfc70d5-dbd0-472a-8fee-4a91e32bf69e

	measure 'Revenue Share %' = DIVIDE ( [Revenue], CALCULATE ( [Revenue], ALLSELECTED ( rtl_product ) ) )
		formatString: 0.0%
		displayFolder: Product
		lineageTag: 68d41452-e6f1-4736-b1c3-48b23da2deda

	/// Cumulative revenue share by product, largest first (Pareto line)
	measure 'Pareto Cum %' =
			VAR _cur = [Revenue]
			VAR _tbl = ADDCOLUMNS ( ALLSELECTED ( rtl_product[product_name] ), "@r", [Revenue] )
			RETURN
			    IF (
			        NOT ISBLANK ( _cur ),
			        DIVIDE ( SUMX ( FILTER ( _tbl, [@r] >= _cur ), [@r] ), SUMX ( _tbl, [@r] ) )
			    )
		formatString: 0%
		displayFolder: Product
		lineageTag: 93a3fa59-afc7-404e-bf1b-6ad78633465e

	measure 'Revenue Top 10 Product' = IF ( RANKX ( ALLSELECTED ( rtl_product[product_name] ), [Revenue],, DESC ) <= 10, [Revenue] )
		formatString: #,0
		displayFolder: Product
		lineageTag: b46ec396-c7e0-4601-a3c1-4b398e562d11

	measure 'Units Bottom 10 Product' =
			VAR _u = [Units]
			RETURN
			    IF ( NOT ISBLANK ( _u ) && RANKX ( FILTER ( ALLSELECTED ( rtl_product[product_name] ), NOT ISBLANK ( [Units] ) ), [Units],, ASC ) <= 10, _u )
		formatString: #,0
		displayFolder: Product
		lineageTag: f7a56054-c774-4ba1-b698-6efb28e93512

	measure 'Revenue Top 5 Store' = IF ( RANKX ( ALLSELECTED ( rtl_store[store_location] ), [Revenue],, DESC ) <= 5, [Revenue] )
		formatString: #,0
		displayFolder: Store
		lineageTag: a713c914-b65c-462e-a229-4ff5b778095f

	measure 'Revenue Bottom 5 Store' =
			VAR _r = [Revenue]
			RETURN
			    IF ( NOT ISBLANK ( _r ) && RANKX ( FILTER ( ALLSELECTED ( rtl_store[store_location] ), NOT ISBLANK ( [Revenue] ) ), [Revenue],, ASC ) <= 5, _r )
		formatString: #,0
		displayFolder: Store
		lineageTag: 68c794e6-8d8b-4f90-a49f-c20ad268a2bb

