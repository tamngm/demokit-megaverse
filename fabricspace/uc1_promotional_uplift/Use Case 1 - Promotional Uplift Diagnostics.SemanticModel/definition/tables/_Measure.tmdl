	measure 'Discount Bucket Lable' = ```
			
			VAR dis_val = [Price Discount Current]
			RETURN 
			SWITCH(TRUE(),
			    dis_val = 0, "No Discount",
			    dis_val > 0 && dis_val <= 0.10, "0-10%",
			    dis_val > 0.10 && dis_val <= 0.20, "10-20%",
			    dis_val > 0.20 && dis_val <= 0.30, "20-30%",
			    dis_val > 0.30 && dis_val <= 0.40, "30-40%",
			    dis_val > 0.40 && dis_val <= 0.50, "40-50%",
			    dis_val > 0.50, "50%+",
			    "Unknown"
			)
