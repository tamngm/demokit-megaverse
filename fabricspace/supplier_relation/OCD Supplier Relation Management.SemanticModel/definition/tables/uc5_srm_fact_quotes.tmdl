	column quote_number
		dataType: string
		lineageTag: 73b064ea-24ae-40b0-ad2b-f8edc6d3c5d9
		summarizeBy: none
		sourceColumn: quote_number

		annotation SummarizationSetBy = Automatic

	/// Number of source documents grouped in this quote (usually 1)
	column document_count
		dataType: int64
		formatString: 0
		lineageTag: fe12f6f6-b239-4f2f-b34f-19166acfe2fc
		summarizeBy: sum
